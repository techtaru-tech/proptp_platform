# Copy to server/.env on the box. Never commit the real file.

DATABASE_URL="postgresql://propto:CHANGE_ME@127.0.0.1:5432/propto_platform?schema=public"

PORT=4700   # 4600 on the live box (see deploy/server-setup.sh)
NODE_ENV=production

# Browser origin allowed to call this API.
CLIENT_ORIGIN="https://app.proptocrm.com"

# Public base of this server. Every webhook URL handed to Meta, Airphone, Brevo and
# WhatsApp is built from it, and so is the unsubscribe link.
PUBLIC_BASE_URL="https://app.proptocrm.com"

# openssl rand -hex 32  — both of these. Changing JWT_SECRET signs everyone out;
# changing ENCRYPTION_KEY makes every stored credential unreadable, so set them once.
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="30d"
ENCRYPTION_KEY="CHANGE_ME"

ORG_TIME_ZONE="Asia/Kolkata"

# TEMPORARY — a master OTP that verifies any number, for testing before SMS is wired.
# While this is set, anyone who knows the code can sign in as any partner. Delete the
# line the moment a real SMS gateway is plugged into services/otp.ts.
# OTP_BYPASS_CODE="123456"

# Only used the first time the seed runs.
SEED_ADMIN_EMAIL="admin@proptocrm.com"
SEED_ADMIN_PASSWORD="CHANGE_ME"

# Meta Lead Ads: per-connection credentials are stored in the database. These two are
# only needed for the "Connect with Facebook" OAuth flow.
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="CHANGE_ME"

# Firebase Cloud Messaging — push notifications to the partner app.
# The service account JSON is a private key: keep it out of git. Either drop the file at
# server/firebase-service-account.json (gitignored, and the default this looks for), or point
# FIREBASE_SERVICE_ACCOUNT_PATH somewhere else. Without it, notifications are still recorded
# and appear in the app's feed; no phone is woken up.
# FIREBASE_SERVICE_ACCOUNT_PATH="/home/ec2-user/propto/server/firebase-service-account.json"

# The panel assistant (Settings: none; needs a key from console.anthropic.com).
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
